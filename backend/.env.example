# Application Port & Environment
PORT=5000
NODE_ENV=production

# PostgreSQL Database Configuration (Local / Direct parameters)
PGUSER=postgres
PGPASSWORD=your_secure_password
PGHOST=localhost
PGPORT=5432
PGDATABASE=nuv_department_db
PGSSL=false

# Cloud Deployment Connection String (Neon / Supabase / Render / Railway / AWS RDS)
# DATABASE_URL=postgresql://username:password@host:port/database_name?sslmode=require
# DATABASE_SSL=true

# Authentication & Security
JWT_SECRET=your_production_jwt_secret_key_here
